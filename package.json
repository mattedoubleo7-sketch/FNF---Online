{
  "name": "friday-night-funkin-game",
  "version": "1.0.0",
  "description": "FNF Onliine with server-based online rooms.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "server": "node server.js",
    "dist:online": "electron-builder --win nsis --config.directories.output=dist-online-installer",
    "dist:offline": "electron-builder --win nsis --config builder-offline.json --config.directories.output=dist-offline-installer"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^40.8.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.matth.fnfbrowserjam",
    "productName": "FNF Onliine",
    "files": [
      "main.js",
      "preload.js",
      "desktop-mode.js",
      "remote-server-url.txt",
      "server.js",
      "downloads.html",
      "FNF - Online.html",
      "FNF - Offline.html",
      "online-mode.js",
      "webgl-renderer.js",
      "sprite-data.js",
      "sporting-chart.js",
      "boxing-match-chart.js",
      "boxing-match-wg-chart.js",
      "boxing-match-wg-visual-data.js",
      "boxing-match-wg-shader-events.js",
      "boxing-match-wg-mode.js",
      "combat-chart.js",
      "one-hit-chart.js",
      "shimmy-chart.js",
      "overthrone-data.js",
      "overthrone-mode.js",
      "silly-billy-data.js",
      "silly-billy-lyric-data.js",
      "silly-billy-mode.js",
      "combat-visual-data.js",
      "shimmy-visual-data.js",
      "combat-mode.js",
      "ballistic-data.js",
      "ballistic-mode.js",
      "boxing-fight-mode.js",
      "boxing-fight-data.js",
      "perseverance-data.js",
      "assets/**/*",
      "*.ogg",
      "package.json",
      "broken-reality-data.js",
      "broken-reality-mode.js",
      "broken-reality-fix.js",
      "broken-reality-soul-data.js",
      "*.mp4",
      "auto-update.js",
      "challenge-edd-data.js",
      "challenge-edd-mode.js",
      "challenge-edd-bf-data.js",
      "fallen-stars-data.js",
      "fallen-stars-mode.js",
      "!assets/indie-cross/**",
      "playback-stability-fix.js",
      "playback-start-fix.js",
      "genocide-data.js",
      "genocide-commands.js",
      "genocide-mode.js",
      "universal-stage-parallax.js",
      "!sansational-inst.ogg",
      "!sansational-voices.ogg",
      "!last-reel-inst.ogg",
      "!last-reel-voices.ogg"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "FNF-Browser-Jam-${version}-portable.${ext}",
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false,
      "icon": "assets/icon.ico"
    },
    "npmRebuild": false,
    "icon": "assets/icon.ico",
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/mattedoubleo7-sketch/FNF---Online/releases/download/ONLINE"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "artifactName": "FNF-Browser-Jam-${version}-portable.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.3",
    "express": "^4.21.2",
    "playwright": "^1.60.0",
    "socket.io": "^4.8.1"
  },
  "engines": {
    "node": ">=20"
  },
  "fnfDefaultDesktopMode": "online"
}
